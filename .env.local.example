# Copy to .env.local. Without this set, the app runs in mock mode.
#
# Setup (one time, ~2 minutes):
#
# 1. Go to https://www.notion.so/profile/integrations
# 2. Create a new "Internal integration" named "Symposium Viewer"
# 3. Copy the "Internal Integration Secret" into NOTION_TOKEN below
# 4. In Notion, open the v5 hub page:
#    https://www.notion.so/35ffda9cff6381f8ba77cd69b20e0982
#    Click "..." (top right) → Connections → add "Symposium Viewer".
#
#    That's the ONLY page you share. All attendee notebooks under this hub
#    inherit the integration's access automatically (Notion's permission
#    model propagates down the page tree). New notebooks added later as
#    subpages of the hub are also auto-accessible — no per-page work.

NOTION_TOKEN=

# Optional: pin a specific port (otherwise a random free port in 7000-9999 is picked)
# PORT=7412
